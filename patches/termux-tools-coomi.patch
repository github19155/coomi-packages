diff --git a/packages/termux-tools/build.sh b/packages/termux-tools/build.sh
--- a/packages/termux-tools/build.sh
+++ b/packages/termux-tools/build.sh
@@ -28,9 +28,25 @@
-termux_step_post_make_install() {
-	TERMUX_PKG_CONFFILES="$(cat "$TERMUX_PKG_BUILDDIR/conffiles")"
-}
-
-termux_step_create_debscripts() {
-	cat <<- EOF > ./preinst
-	$(cat "$TERMUX_PKG_BUILDDIR/preinst")
-	EOF
-}
+termux_step_post_make_install() {
+	TERMUX_PKG_CONFFILES="$(cat "$TERMUX_PKG_BUILDDIR/conffiles")"
+}
+
+coomi_termux_tools_rewrite_paths() {
+	local coomi_termux_tools_root="$TERMUX_PKG_MASSAGEDIR/$TERMUX_PREFIX_CLASSICAL"
+	while IFS= read -r -d '' coomi_termux_tools_file; do
+		if grep -aFq '/data/data/com.termux' "$coomi_termux_tools_file"; then
+			sed -i "s#/data/data/com.termux#${TERMUX_APP__DATA_DIR}#g" "$coomi_termux_tools_file"
+		fi
+	done < <(find "$coomi_termux_tools_root" -type f -print0)
+}
+
+termux_step_post_massage() {
+	coomi_termux_tools_rewrite_paths
+}
+
+termux_step_create_debscripts() {
+	cat <<- EOF > ./preinst
+	$(cat "$TERMUX_PKG_BUILDDIR/preinst")
+	EOF
+}
+	if grep -Fq '/data/data/com.termux' ./preinst; then
+		sed -i "s#/data/data/com.termux#${TERMUX_APP__DATA_DIR}#g" ./preinst
+	fi
