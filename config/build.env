# Fixed inputs for the Coomi Termux package canary.
TERMUX_PACKAGES_REPOSITORY=https://github.com/termux/termux-packages.git
TERMUX_PACKAGES_COMMIT=4dc8135244ea3909858aaf441f37cc076fe63db7
TERMUX_BUILDER_IMAGE_NAME=ghcr.io/termux/package-builder

COOMI_APP_PACKAGE=com.coomi.android
COOMI_DATA_DIR=/data/data/com.coomi.android
COOMI_PREFIX=/data/data/com.coomi.android/files/usr
COOMI_VERSION_SUFFIX=+coomi1
COOMI_ANDROID_API_BASELINE=apt-android-7

TERMUX_ARCH=aarch64
TERMUX_PKG_API_LEVEL=24
TERMUX_PACKAGE_FORMAT=debian
TERMUX_PACKAGE_LIBRARY=bionic
TERMUX_CANARY_PACKAGE=bash
COOMI_ARTIFACT_NAME=coomi-bash-canary

# Explicit package roots for staged builds. Termux's build-package.sh resolves
# and builds transitive dependencies for each root in one deterministic call.
COOMI_BOOTSTRAP_PACKAGES="-"
COOMI_NODEJS_PACKAGES="nodejs-lts npm"
COOMI_PYTHON_PACKAGES="python python-pip"
COOMI_UV_PACKAGES="uv"
COOMI_GIT_PACKAGES="git openssh"
COOMI_ENABLED_STAGE=bash
COOMI_STAGE_MANIFEST=config/dependency-closures.csv
